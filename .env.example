NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_LEAGUE_ID=

# app/api/espn-sync: pulls real scores/starters/actual points from ESPN and
# projections from Sleeper on a schedule (see vercel.json).
#
# ESPN_S2/SWID are optional now that the league is public -- only needed if
# it's ever switched back to private. If so: open fantasy.espn.com logged in,
# DevTools > Application > Cookies, copy the espn_s2 and SWID values (SWID
# includes the surrounding {}).
# CRON_SECRET is a random string you also set as the Authorization bearer
# token Vercel Cron sends; without it the sync route is unauthenticated.
# Recommended even for a public league, since the route still writes to the
# DB and shouldn't be triggerable by anyone with the URL.
ESPN_S2=
ESPN_SWID=
CRON_SECRET=
