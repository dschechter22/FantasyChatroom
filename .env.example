NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_LEAGUE_ID=

# app/api/espn-sync: pulls real scores/starters/actual points from ESPN and
# projections from Sleeper on a schedule (see vercel.json). ESPN_S2/SWID are
# the league owner's own ESPN session cookies (private league, no public
# API) -- open fantasy.espn.com logged in, DevTools > Application > Cookies,
# copy the espn_s2 and SWID values (SWID includes the surrounding {}).
# CRON_SECRET is a random string you also set as the Authorization bearer
# token Vercel Cron sends; without it the sync route is unauthenticated.
ESPN_S2=
ESPN_SWID=
CRON_SECRET=
